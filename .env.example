# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Database - empfohlen: Pfad außerhalb des Projektverzeichnisses
# macOS:  sqlite:////Users/DEINNAME/.local/share/dozentenmanager/dozentenmanager.db
# Linux:  sqlite:////var/lib/dozentenmanager/dozentenmanager.db
# Ohne Angabe: Development nutzt dev_dozentenmanager.db im Projektverzeichnis,
#              Production nutzt ~/.local/share/dozentenmanager/dozentenmanager.db
# DATABASE_URL=sqlite:////Users/DEINNAME/.local/share/dozentenmanager/dozentenmanager.db

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Logging
LOG_LEVEL=INFO

# Admin-User beim Start erstellen (optional)
# Wird beim App-Start angelegt, falls noch nicht vorhanden
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-in-production
